"""
Airflow DAG: {{ session_id }} Data Quality Pipeline
Generated by AI DQ Accelerator on {{ generated_at }}

Dataset: {{ use_case }}
Transformations applied: {{ transformation_log | length }}
Quality score: {{ baseline_score }} → {{ final_score }}
"""
from __future__ import annotations

from datetime import datetime, timedelta
from airflow import DAG
from airflow.operators.python import PythonOperator
from airflow.operators.bash import BashOperator

{% if target_env.slack_channel %}
from airflow.providers.slack.operators.slack_webhook import SlackWebhookOperator
{% endif %}

default_args = {
    "owner": "data-engineering",
    "depends_on_past": False,
    "start_date": datetime({{ generated_at[:4] }}, {{ generated_at[5:7] }}, {{ generated_at[8:10] }}),
    "email_on_failure": False,
    "email_on_retry": False,
    "retries": 3,
    "retry_delay": timedelta(minutes=5),
}

dag = DAG(
    "dq_pipeline_{{ session_id[:8] }}",
    default_args=default_args,
    description="{{ use_case }}",
    schedule_interval="{{ target_env.schedule | default('@daily') }}",
    catchup=False,
    tags=["data-quality", "generated"],
)


# ── Transformation nodes ────────────────────────────────────────────────────

{% for transform in transformation_log %}
{% if transform.status == 'applied' %}
{% if transform.type == 'custom' %}
# Custom transformation: {{ transform.params.description | default(transform.id) }}
from dq_tools_runtime.nodes import CustomCodeTransform

{{ transform.id }}_transform = PythonOperator(
    task_id="{{ transform.id }}_transform",
    python_callable=CustomCodeTransform(
        code={{ transform.params.code | tojson }},
        function_name="transform",
        description={{ (transform.params.description | default("Custom transformation")) | tojson }},
    ).execute,
    op_kwargs={"input_key": "xcom_working_data"},
    dag=dag,
)

{% else %}
# Pre-built transformation: {{ transform.type }} on {{ transform.params.get('column', transform.params.get('columns', '')) }}
def apply_{{ transform.id }}(**context):
    import pandas as pd
    import duckdb

    df = context["ti"].xcom_pull(key="working_data", task_ids=context["ti"].task_id.replace("{{ transform.id }}", "prev"))
    if df is None:
        raise ValueError("No working data in XCom")

    {% if transform.type == 'date_format_cast' %}
    for col in {{ transform.params.columns }}:
        df[col] = pd.to_datetime(df[col], format="{{ transform.params.from_format }}", errors="coerce").dt.strftime("%Y-%m-%d")
    {% elif transform.type == 'filter_rows' %}
    df = df[df["{{ transform.params.column }}"] != {{ transform.params.value | tojson }}]
    {% elif transform.type == 'winsorize' %}
    df["{{ transform.params.column }}"] = df["{{ transform.params.column }}"].clip(upper={{ transform.params.cap_value }})
    {% elif transform.type == 'impute_constant' %}
    df["{{ transform.params.column }}"] = df["{{ transform.params.column }}"].fillna({{ transform.params.value | tojson }})
    {% elif transform.type == 'null_invalid' %}
    import re
    mask = df["{{ transform.params.column }}"].notna() & ~df["{{ transform.params.column }}"].astype(str).str.match(r"{{ transform.params.pattern }}")
    df.loc[mask, "{{ transform.params.column }}"] = None
    {% endif %}

    context["ti"].xcom_push(key="working_data", value=df.to_dict("records"))

{{ transform.id }}_task = PythonOperator(
    task_id="{{ transform.id }}_transform",
    python_callable=apply_{{ transform.id }},
    dag=dag,
)
{% endif %}
{% endif %}
{% endfor %}


# ── dbt run ─────────────────────────────────────────────────────────────────

dbt_run = BashOperator(
    task_id="dbt_run",
    bash_command="cd {{ '{{' }} var('dbt_project_path') {{ '}}' }} && dbt run --profiles-dir .",
    dag=dag,
)

dbt_test = BashOperator(
    task_id="dbt_test",
    bash_command="cd {{ '{{' }} var('dbt_project_path') {{ '}}' }} && dbt test --profiles-dir .",
    dag=dag,
)


# ── DAG wiring ───────────────────────────────────────────────────────────────

{% set applied = transformation_log | selectattr('status', 'eq', 'applied') | list %}
{% if applied %}
{% for i in range(applied | length) %}
{% if i == 0 %}
dbt_run >> {{ applied[i].id }}_{% if applied[i].type == 'custom' %}transform{% else %}task{% endif %}
{% else %}
{{ applied[i-1].id }}_{% if applied[i-1].type == 'custom' %}transform{% else %}task{% endif %} >> {{ applied[i].id }}_{% if applied[i].type == 'custom' %}transform{% else %}task{% endif %}
{% endif %}
{% endfor %}
{{ applied[-1].id }}_{% if applied[-1].type == 'custom' %}transform{% else %}task{% endif %} >> dbt_test
{% else %}
dbt_run >> dbt_test
{% endif %}
