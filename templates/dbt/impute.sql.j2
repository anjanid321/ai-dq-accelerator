-- dbt model: Impute nulls in {{ params.column }}
-- Generated by AI DQ Accelerator (transformation: {{ transformation_id }})

WITH source AS (
    SELECT * FROM {{ '{{' }} ref('{{ source_table }}') {{ '}}' }}
),

imputed AS (
    SELECT
        COALESCE(
            {{ params.column }},
            {% if params.fill_value is not none %}
            '{{ params.fill_value }}'
            {% else %}
            (SELECT MODE() WITHIN GROUP (ORDER BY {{ params.column }}) FROM source WHERE {{ params.column }} IS NOT NULL)
            {% endif %}
        ) AS {{ params.column }},
        {% for col in all_columns %}
        {% if col != params.column %}
        {{ col }},
        {% endif %}
        {% endfor %}
    FROM source
)

SELECT * FROM imputed
