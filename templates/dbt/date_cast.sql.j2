-- dbt model: Fix date format for {{ params.columns | join(', ') }}
-- Generated by AI DQ Accelerator (transformation: {{ transformation_id }})

WITH source AS (
    SELECT * FROM {{ '{{' }} ref('{{ source_table }}') {{ '}}' }}
),

cast_dates AS (
    SELECT
        {% for col in params.columns %}
        TRY_CAST(
            CASE
                WHEN {{ col }} IS NULL THEN NULL
                ELSE TO_DATE({{ col }}, '{{ params.from_format | replace('%Y', 'YYYY') | replace('%m', 'MM') | replace('%d', 'DD') }}')
            END AS DATE
        ) AS {{ col }},
        {% endfor %}
        {% for col in all_columns %}
        {% if col not in params.columns %}
        {{ col }},
        {% endif %}
        {% endfor %}
    FROM source
)

SELECT * FROM cast_dates
